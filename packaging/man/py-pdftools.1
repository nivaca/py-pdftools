Reorder pages and place them two per sheet side for folding into a booklet.

positional arguments:
  input                 source PDF

options:
  -h, --help            show this help message and exit
  -o, --output OUTPUT   output PDF (default: <input>-<command>.pdf)
  --binding {perfect,saddle,continuous,cut-stack}
                        perfect: separate folded signatures, stacked;
                        saddle: all sheets nested and folded together;
                        continuous: pages in order 1,2 | 3,4 (not folded);
                        cut-stack: sheets are cut in half and the stacks
                        placed one on the other (default: perfect)
  --signature, --pages-per-fold N
                        pages per signature for perfect binding; multiple of
                        4 (default: 4)
  --pad-last {full,multiple-of-4}
                        perfect binding: pad a short last signature to full
                        length or just to a multiple of 4
  --single-sided        cut-stack: single-sided stacks
  --direction {left,right}
                        binding edge: left (left-to-right books) or right
                        (right-to-left) (default: left)
  --paper SIZE          sheet size: a0, a1, a2, a3, a4, a5, a6, b4, b5,
                        executive, ledger, legal, letter, max, sra3,
                        statement, tabloid, auto, or WxH such as 21x29.7cm
                        (default: legal)
  --orientation {tall,wide,portrait,landscape,best,as-is}
                        sheet orientation (default: wide)
  --margin LEN          space at the edge of the sheet on all four sides
                        (default: 0)
  --margin-top LEN      top space at the edge of the sheet (overrides
                        --margin)
  --margin-bottom LEN   bottom space at the edge of the sheet (overrides
                        --margin)
  --margin-left LEN     left space at the edge of the sheet (overrides
                        --margin)
  --margin-right LEN    right space at the edge of the sheet (overrides
                        --margin)
  --gutter LEN          space between the two pages (default: 0)
  --no-auto-scale       shrink pages that don't fit, never enlarge
  --no-scale            place pages at 100%; fail if they don't fit
  --align {center,fold,spine}
                        center pages in their half of the sheet, or pull
                        them to the fold/spine (default: center)
  --sides {duplex,flip-backs,fronts-then-backs,separate}
                        how to output fronts and backs: duplex (in order),
                        flip-backs (backs upside down), fronts-then-backs
                        (one file, all fronts first), separate (two files)
                        (default: duplex)
  --reverse-backs       output the backs in reverse order (for manual
                        double-sided printing)

preferences:
  --units {cm,mm,in,pt}
                        unit for lengths given without a suffix (default:
                        cm)
  --registration {black,cmyk,all}
                        colour for marks and registration-coloured text:
                        black, CMYK, or all separations
