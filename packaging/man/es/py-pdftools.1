Paso y repetición: cada pliego de salida contiene tantas copias de una página de origen como quepan.

argumentos posicionales:
  input                 PDF de origen

opciones:
  -h, --help            mostrar esta ayuda y terminar
  -o, --output OUTPUT   PDF de salida (por defecto: <input>-<command>.pdf)
  --paper SIZE          tamaño del pliego: a0, a1, a2, a3, a4, a5, a6, b4,
                        b5, executive, ledger, legal, letter, max, sra3,
                        statement, tabloid, o WxH como 21x29.7cm (por
                        defecto: a4)
  --orientation {tall,wide,portrait,landscape,best,as-is}
                        orientación del pliego (por defecto: best)
  --cols COLS           columnas por pliego (máximo, o exacto con --scale
                        fit)
  --rows ROWS           filas por pliego (máximo, o exacto con --scale fit)
  --scale MODE          'none' (100%), 'fit' (escalar para que quepan
                        exactamente --cols x --rows, según la primera
                        página) o un porcentaje como 50 (por defecto: none)
  --trim                recortar el espacio no usado en el borde de cada
                        pliego (el pliego se reduce a las páginas más los
                        márgenes)
  --margin LEN          margin en los cuatro lados (por defecto: 0)
  --margin-top LEN      top margin (anula --margin)
  --margin-bottom LEN   bottom margin (anula --margin)
  --margin-left LEN     left margin (anula --margin)
  --margin-right LEN    right margin (anula --margin)
  --spacing LEN         espacio entre filas y columnas (por defecto: 0)
  --hspace LIST         espaciado horizontal entre columnas; una lista como
                        '0 40' se repite (anula --spacing)
  --vspace LIST         espaciado vertical entre filas; una lista se repite
                        (anula --spacing)
  --align {top-left,top,top-right,left,center,right,bottom-left,bottom,bottom-right}
                        dónde se sitúan las páginas en los pliegos que no
                        están llenos (por defecto: top-left)
  --align-sheets-independently
                        alinear cada pliego por separado en lugar de igualar
                        todos los pliegos
  --align-rows          alinear también cada fila horizontalmente (filas
                        cortas)
  --mirror {none,h,v,hv}
                        reflejar márgenes y alineación en los pliegos pares
                        (reverso): horizontal, verticalmente o en ambos
                        sentidos
  --rotate              permitir filas de copias giradas cuando así caben
                        más en un pliego (no con escalado)

preferencias:
  --units {cm,mm,in,pt}
                        unidad de las longitudes dadas sin sufijo (por
                        defecto: cm)
  --registration {black,cmyk,all}
                        color de las marcas y del texto en color de
                        registro: negro, CMYK o todas las separaciones
  --bleed {use,ignore}  usar las cajas de sangrado de las páginas al
                        imponer, o ignorarlas (por defecto: use)
  --pdfx                conservar una TrimBox al eliminar los sangrados
                        (PDF/X); para hacer un archivo PDF/X-4, use
                        --conform x-4
  --conform {a-1b,a-2b,a-3b,x-4}
                        guardar la salida como PDF/A (a-1b, a-2b, a-3b: para
                        archivo) o PDF/X-4 (x-4: para imprenta), hecho por
                        pdf2iso con Ghostscript, que debe estar instalado
  -q, --quiet           sin avisos
  --interface {en,es}   el idioma de la interfaz, solo para esta ejecución
                        (para conservar una elección, use la orden
                        'interface')

marcas:
  --crop-marks          añadir marcas de corte inteligentes
  --frames              dibujar un marco alrededor de cada página
  --mark-offset LEN     separación entre el borde de la página y la marca de
                        corte (por defecto: 10pt)
  --mark-length LEN     longitud de las marcas de corte (por defecto: 20pt)
  --mark-width LEN      grosor de línea de las marcas de corte (por defecto:
                        0.5pt)
  --mark-white-background
                        dibujar un halo casi blanco detrás de las marcas
                        para que se vean sobre fondos oscuros

fondo:
  --background PDF      imponer sobre las páginas de este PDF en lugar de
                        pliegos en blanco (fija el tamaño del pliego)
  --background-pages RANGE
                        páginas de fondo que se usan
  --background-mode {repeat,once,repeat-last}
                        repetir los fondos, usarlos una vez o repetir solo
                        los N últimos (por defecto: repeat)
  --background-repeat-last N
                        con --background-mode repeat-last: cuántas páginas
                        repetir
.fi
