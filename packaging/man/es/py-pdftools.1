Pegar páginas PDF: añadir un logotipo, sello o anuncio de otro PDF.

argumentos posicionales:
  input                 PDF de origen

opciones:
  -h, --help            mostrar esta ayuda y terminar
  -o, --output OUTPUT   PDF de salida (por defecto: <input>-<command>.pdf)
  --file FILE           PDF cuyas páginas se añaden
  --source-pages RANGE  páginas de --file que usar; se repiten cíclicamente
                        sobre las páginas de destino (por defecto: todas)
  --pages RANGE         target pages: p. ej. 'all', '1-4,7', 'LAST-1..LAST'
                        (por defecto: all)
  --parity {all,odd,even}
                        limitar a números de página impares o pares
  --position {top-left,top-center,top-right,left,center,right,bottom-left,bottom-center,bottom-right}
                        (por defecto: center)
  --offset-x LEN        desplazamiento horizontal, medido en la dirección
