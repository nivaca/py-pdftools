                               [--spread LEN] [--creep LEN] [--media SIZE]
                               [--orientation {portrait,landscape}]
                               [--auto-rotate] [--no-auto-scale] [--enlarge]
                               [--margin LEN] [--margin-top LEN]
                               [--margin-bottom LEN] [--margin-left LEN]
                               [--margin-right LEN] [--page-trim LEN]
                               [--page-trim-top LEN]
                               [--page-trim-bottom LEN]
                               [--page-trim-left LEN]
                               [--page-trim-right LEN] [--trim-marks]
                               [--bleed-marks] [--registration-marks]
                               [--page-info | --no-page-info]
                               input

Imponer un documento en un solo paso, con las disposiciones habituales (folletos de 2, 4 y 8, corte y apilado, secuencial, paso y repetición), encuadernación, medianiles, papel, márgenes y marcas de impresión. El modo básico de la ventana ejecuta esta orden. Para que el contenido de las páginas ocupe más del pliego, recorte sus bordes blancos con --page-trim y déjelas crecer con --enlarge; los márgenes y los medianiles también pueden ser negativos (--margin=-1cm), de modo que las páginas se salgan de los bordes del pliego o se solapen, cortadas en el borde o en la mitad del solapamiento.

argumentos posicionales:
  input                 PDF de origen

opciones:
  -h, --help            mostrar esta ayuda y terminar
  -o, --output OUTPUT   PDF de salida (por defecto: <input>-<command>.pdf)
  --margin LEN          margen en los cuatro lados (por defecto: 0)
  --margin-top LEN      top margen (anula --margin)
  --margin-bottom LEN   bottom margen (anula --margin)
  --margin-left LEN     left margen (anula --margin)
  --margin-right LEN    right margen (anula --margin)
  --page-trim LEN       recorte de página (lo que se corta de los bordes de
                        cada página) en los cuatro lados (por defecto: 0)
  --page-trim-top LEN   top recorte de página (lo que se corta de los bordes
                        de cada página) (anula --page-trim)
  --page-trim-bottom LEN
                        bottom recorte de página (lo que se corta de los
                        bordes de cada página) (anula --page-trim)
  --page-trim-left LEN  left recorte de página (lo que se corta de los
                        bordes de cada página) (anula --page-trim)
  --page-trim-right LEN
                        right recorte de página (lo que se corta de los
                        bordes de cada página) (anula --page-trim)

preferencias:
  --units {cm,mm,in,pt}
                        unidad de las longitudes dadas sin sufijo (por
                        defecto: cm)
  --registration {black,cmyk,all}
                        color de las marcas y del texto en color de
                        registro: negro, CMYK o todas las separaciones
  --bleed {use,ignore}  usar las cajas de sangrado de las páginas al
                        imponer, o ignorarlas (por defecto: use)
  --pdfx                conservar una TrimBox al eliminar los sangrados
                        (PDF/X); para hacer un archivo PDF/X-4, use
                        --conform x-4
  --conform {a-1b,a-2b,a-3b,x-4}
                        guardar la salida como PDF/A (a-1b, a-2b, a-3b: para
                        archivo) o PDF/X-4 (x-4: para imprenta), hecho por
                        pdf2iso con Ghostscript, que debe estar instalado
  -q, --quiet           sin avisos
  --interface {en,es}   el idioma de la interfaz, solo para esta ejecución
                        (para conservar una elección, use la orden
                        'interface')

disposición:
  --layout {2up-booklet,4up-booklet,8up-booklet,cut-stacks,sequential,step-repeat}
                        2up-booklet: 2 páginas una al lado de otra; 4up-
                        booklet: 2 filas de 2; 8up-booklet: 2 filas de 4;
                        cut-stacks: cortar los pliegos y apilar las pilas;
                        sequential: páginas en orden; step-repeat: copias de
                        cada página (por defecto: 2up-booklet)
  --cols COLS           columnas, para cut-stacks, sequential y step-repeat
                        (por defecto: 2)
  --rows ROWS           filas, para cut-stacks, sequential y step-repeat
                        (por defecto: 2)

encuadernación:
  --binding {saddle,perfect}
                        saddle: todos los pliegos plegados juntos y
                        grapados; perfect: pilas de pliegos plegados,
                        encoladas por el lomo (por defecto: perfect)
  --sheets-per-fold N   encuadernación encolada: pliegos en cada cuadernillo
                        plegado (por defecto: 4)
  --direction {left,right}
                        borde de encuadernación (por defecto: left)
  --single-sided        imprimir por una sola cara: los anversos y luego los
                        reversos (folletos), o pilas a una cara

medianiles:
  --gutter-v LEN        espacio entre columnas (por defecto: 0)
  --gutter-h LEN        espacio entre filas (por defecto: 0)
  --spread LEN          8up-booklet: espacio entre la 2.ª y la 3.ª columna
                        (por defecto: como --gutter-v)
  --creep LEN           folletos: cuánto se desplazan hacia el lomo las
                        páginas más interiores, por el grosor del papel (por
                        defecto: 0)

papel:
  --media SIZE          tamaño del pliego: un nombre de papel o WxH, o
                        'auto' para ajustarse exactamente a las páginas (por
                        defecto: legal)
  --orientation {portrait,landscape}
                        orientación de un tamaño de pliego con nombre (por
                        defecto: landscape)
  --auto-rotate         girar las páginas 90° cuando así encajan mejor en su
                        celda
  --no-auto-scale       no reducir las páginas más grandes que su celda
  --enlarge             ampliar también las páginas más pequeñas que su
                        celda, para llenarla

marcas de impresión:
  --trim-marks          marcas donde se han de cortar las páginas
  --bleed-marks         contorno del área de sangrado de las páginas que la
                        tienen
  --registration-marks  dianas en los lados del pliego, para alinear las
                        planchas
  --page-info, --no-page-info
                        el nombre del documento, el número de pliego, la
                        fecha y la hora arriba a la izquierda de cada pliego
                        (activado por defecto; --no-page-info lo omite)
.fi
